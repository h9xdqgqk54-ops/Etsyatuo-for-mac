{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/media/etsy-agent/:path*", "destination": "/api/index" },
    { "source": "/etsy-image-agent", "destination": "/etsy-image-agent.html" },
    { "source": "/settings/openai", "destination": "/openai-settings.html" },
    { "source": "/settings/image-provider-settings", "destination": "/openai-settings.html" },
    { "source": "/app", "destination": "/etsy-image-agent.html" },
    { "source": "/asset-library", "destination": "/etsy-image-agent.html" },
    { "source": "/", "destination": "/etsy-image-agent.html" }
  ]
}
