# Etsyauto Image Agent: GPT5.5 text/vision + isolated OpenAI image workflow.
PROMPT_PROVIDER=gpt55
GPT55_API_KEY=your_gpt55_key_here
GPT55_BASE_URL=https://allin-api.com/v1
GPT55_MODEL=gpt-5.5
GPT55_MAX_INPUT_MB=5
GPT55_BATCH_LIMIT=10

IMAGE_AGENT_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
# Optional: OpenAI-compatible relay / proxy endpoint. Leave empty for official OpenAI.
# Include the /v1 path when your relay requires it.
OPENAI_BASE_URL=https://allin-api.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low
# off omits the optional input_fidelity request parameter for better relay compatibility.
OPENAI_IMAGE_INPUT_FIDELITY=off
OPENAI_IMAGE_MAX_INPUT_MB=20
IMAGE_AGENT_ENABLE_REAL_GENERATION=true

# Local folders. Defaults are ~/Desktop/图片输入 and ~/Desktop/图片输出.
# These can also be changed from the /etsy-image-agent folder settings panel.
IMAGE_AGENT_INPUT_DIR=
IMAGE_AGENT_OUTPUT_DIR=

# Local default: /settings/openai can store OpenAI and GPT5.5 Prompt Provider
# settings in server process memory. Keys are not written to localStorage,
# sessionStorage, or secure-config.json. GPT5.5 Base URL/model saved in the
# web UI become active for the current service process immediately; the test
# button is diagnostic only. Valid .env API keys take precedence.
# In hosted deployments, set this explicitly only if you want web-entered BYOK.
IMAGE_AGENT_ALLOW_WEB_KEY_CONFIG=true

# Optional local data locations.
# CLI / Windows exe mode sets defaults under the user's app data folder
# when these values are not provided. On Windows that is %APPDATA%/Etsyauto.
ETSY_AGENT_STORAGE_PATH=storage/etsy-agent
ETSY_AGENT_CONFIG_PATH=data/etsy-agent/secure-config.json
ETSY_AGENT_SECURITY_LOG_PATH=data/etsy-agent/security-events.log
ETSY_AGENT_MAX_CONCURRENCY=2
ETSY_AGENT_MAX_TOTAL_GENERATIONS=60

# Prompt records are bound to inputAssetId and saved in data/etsy-agent/prompt-records.json.
